# Used when running the services on your machine with npm. Docker Compose sets its own hosts.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000/api

IDENTITY_MONGODB_URI=mongodb://localhost:27017/landed_identity?directConnection=true
REDIS_HOST=localhost
REDIS_PORT=6380

# Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me

# OAuth 2.0 Web client ID from Google Cloud Console. Same value as the frontend.
GOOGLE_CLIENT_ID=

# Mailpit catches all email in development. Read it at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Landed <no-reply@landed.local>
